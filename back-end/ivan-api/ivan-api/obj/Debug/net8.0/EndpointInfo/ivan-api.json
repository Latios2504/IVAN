                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponseDTOApiResponseDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponseDTOApiResponseDTO"
                }
              }
